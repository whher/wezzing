---
import SectionTitle from "./SectionTitle.astro";
import { wedding } from "../config/wedding";
---

<section
  id="story"
  class="bg-[var(--rose)] px-6 py-28 text-[var(--brown)]"
>
  <div class="container-wedding">

      <SectionTitle
        eyebrow="A little bit about us"
        title={wedding.story.title}
      />

    <div
      class="grid gap-10 md:grid-cols-2 md:items-center"
    >
      <div class="reveal">
        <img
          src={`${import.meta.env.BASE_URL}photos/story.JPEG`}
          alt="The couple together"
          class="aspect-[4/4] max-w-md object-cover"
        />
      </div>

      <div class="space-y-6 leading-8 reveal">
        {
          wedding.story.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>