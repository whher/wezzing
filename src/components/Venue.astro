---
import { MapPin, Calendar } from "lucide-astro";
import SectionTitle from "./SectionTitle.astro";
import Countdown from "./Countdown.astro";
import { wedding } from "../config/wedding";
import { Image } from 'astro:assets';
import happy from '../assets/happy.png';
---

<section
  id="wedding"
  class="bg-[var(--darksage)] px-6 py-28"
>
  <div class="flex items-center justify-center mb-10">
      <Image
        src={happy}
        alt="Red Double Happiness Emblem"
        style="width: 80%; max-width: 128px; height: auto;"
      />
  </div>

  <div class="container-wedding">

    <div class="text-[var(--cream)]">
      <SectionTitle
        eyebrow="Save the date"
        title="The Wedding"
      />
    </div>

    <Countdown />

    <div class="grid overflow-hidden rounded-3xl bg-[var(--cream)] md:grid-cols-2">
      <div class="p-8 md:p-12 reveal">
        <div class="mb-8 flex gap-4">
          <Calendar
            size={20}
            strokeWidth={1.5}
            class="opacity-70"
          />

          <div>
            <p class="text-md uppercase tracking-widest opacity-70">
              Date
            </p>

            <p class="mt-2 text-3xl">
              {wedding.date.display}
            </p>
          </div>
        </div>

        <div class="mb-10 flex gap-4">
          <MapPin
            size={20}
            strokeWidth={1.5}
            class="opacity-70"
          />

          <div>
            <p class="text-md uppercase tracking-widest opacity-70">
              Location
            </p>

            <p class="mt-2 text-3xl">
              {wedding.venue.name}
            </p>

            <p class="mt-2 text-lg leading-6">
              {wedding.venue.address}
            </p>
          </div>
        </div>

        <a
          href={wedding.venue.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-full bg-[var(--brown)] px-6 py-3 transition hover:-translate-y-1"
        >
          <span class="text-[var(--cream)] text-lg">
          Google Maps
          </span>
        </a>
      </div>

      <div class="min-h-[350px] bg-[#ddd]">
        <iframe
          title="Wedding venue location"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2666.2270196471304!2d11.19826377619396!3d48.067260771235894!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479c2ccb9491f1ff%3A0x20beba552d010744!2sAugustiner%20am%20W%C3%B6rthsee%20%2F%20Strandbad%20Fleischmann%20%2F%20Kiosk%20%26%20Biergarten!5e0!3m2!1sen!2sde!4v1788599663305!5m2!1sen!2sde"
          class="h-full min-h-[350px] w-full border-0"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>
</section>