---
import { ArrowDown } from "lucide-astro";
import { wedding } from "../config/wedding";
import { Image } from 'astro:assets';
import hero from '../assets/hero.JPEG';
---

<section
  id="top"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
>
<Image
  src={hero}
  alt="A photo of the couple"
  width={2400}
  height={1600}
  class="absolute inset-0 h-full w-full object-cover"
/>

  <div class="absolute inset-0 bg-black/30"></div>

  <div class="relative z-10 px-6 text-center text-[var(--cream)]">
    <p class="mb-6 text-md uppercase tracking-[0.35em]">
      We're getting married
    </p>

    <h1 class="whitespace-nowrap text-6xl leading-tight md:text-7xl lg:text-8xl">
    <span class="text-5xl leading-tight md:text-6xl lg:text-7xl">{wedding.couple.partner1}</span>
    <span class="mx-2 text-[var(--darkrose)]"> & </span>
    {wedding.couple.partner2}
    </h1>

    <p class="mt-8 text-2xl">
      {wedding.date.display}
    </p>

    <a
      href="#countdown"
      class="mx-auto mt-14 flex w-fit flex-col items-center gap-2"
    >
      <span class="text-md uppercase tracking-[0.25em]">
        Scroll to explore
      </span>

      <ArrowDown class="animate-bounce" />
    </a>
  </div>
</section>