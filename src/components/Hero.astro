---
import { ArrowDown } from "lucide-astro";
import { wedding } from "../config/wedding";
---

<section
  id="top"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
>
  <img
    src={`${import.meta.env.BASE_URL}photos/hero.JPEG`}
    alt="A photo of the couple"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div class="absolute inset-0 bg-black/30"></div>

  <div
    class="relative z-10 px-6 text-center text-white"
  >
    <p class="mb-6 text-sm uppercase tracking-[0.35em]">
      We're getting married
    </p>

    <h1
      class="whitespace-nowrap font-serif text-6xl leading-tight md:text-6xl lg:text-[10rem]"
    >

   <span class="text-[var(--cream)]">
    {wedding.couple.partner1}
    </span>

    <span class="mx-2 text-[var(--darkrose)]"> & </span>

    <span class="text-[var(--cream)]">
      {wedding.couple.partner2}
    </span>
    </h1>

    <p class="mt-8 text-lg">
      {wedding.date.display}
    </p>

    <a
      href="#countdown"
      class="mx-auto mt-14 flex w-fit flex-col items-center gap-2"
    >
      <span class="text-xs uppercase tracking-[0.25em]">
        Scroll to explore
      </span>

      <ArrowDown class="animate-bounce" />
    </a>
  </div>
</section>