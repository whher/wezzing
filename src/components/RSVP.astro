---
import SectionTitle from "./SectionTitle.astro";
import { wedding } from "../config/wedding";
---

<section
  id="rsvp"
  class="bg-[var(--rose)] px-6 py-28 text-[var(--brown)]"
>
  <div class="container-wedding max-w-2xl">
    <div class="mb-12 text-center reveal">
      <SectionTitle
        eyebrow="We hope you can make it"
        title="RSVP"
      />
    </div>

    <form
      id="rsvp-form"
      class="space-y-6 reveal text-lg"
    >
      <div>
        <label for="name" class="mb-2 block">
          Your name
        </label>

        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-xl text-[var(--brown)] border border-black/10 bg-white px-4 py-3 outline-none transition focus:border-[var(--sage)]"
        />
      </div>

      <div>
        <label class="mb-3 block">
          Will you attend?
        </label>

        <div class="flex gap-6">
          <label class="flex items-center gap-2">
            <input
              type="radio"
              name="attending"
              value="yes"
              required
            />
            Yes! ❤️
          </label>

          <label class="flex items-center gap-2">
            <input
              type="radio"
              name="attending"
              value="no"
            />
            Sadly no
          </label>
        </div>
      </div>

<div id="attendance-details" hidden>
  <div>
    <label
      for="adults"
      class="mb-2 block"
    >
      Number of adults
    </label>
    <input
      id="adults"
      name="adults"
      type="number"
      min="0"
      max="10"
      value="1"
      required
      disabled
      class="w-full rounded-xl border text-[var(--brown)] border-black/10 bg-white px-4 py-3 outline-none transition focus:border-[var(--sage)]"
    />
  </div>

  <div class="mt-6">
    <label
      for="children"
      class="mb-2 block"
    >
      Number of children
    </label>
    <input
      id="children"
      name="children"
      type="number"
      min="0"
      max="10"
      value="0"
      required
      disabled
      class="w-full rounded-xl border text-[var(--brown)] border-black/10 bg-white px-4 py-3 outline-none transition focus:border-[var(--sage)]"
    />
  </div>

  <div class="mt-6">
    <label
      for="dietary"
      class="mb-2 block"
    >
      Dietary requirements
    </label>
    <textarea
      id="dietary"
      name="dietary"
      rows="3"
      disabled
      class="w-full rounded-xl border text-[var(--brown)] border-black/10 bg-white px-4 py-3 outline-none focus:border-[var(--sage)]"
    ></textarea>
  </div>

  <div class="mt-6">
    <label
      for="message"
      class="mb-2 block"
    >
      A message for us
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      disabled
      class="w-full rounded-xl border text-[var(--brown)] border-black/10 bg-white px-4 py-3 outline-none focus:border-[var(--sage)]"
    ></textarea>
  </div>
</div>

      <p class="text-sm">
      Someone say Datenschutz? I am using Google Apps to collect this data. Just so you know.
      </p>

      <button
        type="submit"
        class="w-full rounded-full bg-[var(--cream)]/90 px-6 py-4 text-lg text-[var(--brown)] transition hover:-translate-y-1"
      >
        Send RSVP
      </button>

      <p
        id="rsvp-status"
        class="text-center text-sm"
      ></p>
    </form>
  </div>
</section>

<script define:vars={{ endpoint: wedding.rsvp.googleScriptUrl }}>
  const form = document.querySelector("#rsvp-form");
const status = document.querySelector("#rsvp-status");
const attendanceDetails = document.querySelector("#attendance-details");
const attendanceOptions = document.querySelectorAll(
  'input[name="attending"]'
);

function updateAttendanceDetails() {
  const attending = document.querySelector(
    'input[name="attending"]:checked'
  )?.value;

  const showDetails = attending === "yes";

  attendanceDetails.hidden = !showDetails;

  attendanceDetails
    .querySelectorAll("input, textarea")
    .forEach((field) => {
      field.disabled = !showDetails;
    });
}

attendanceOptions.forEach((option) => {
  option.addEventListener("change", updateAttendanceDetails);
});

updateAttendanceDetails();

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!endpoint) {
      status.textContent =
        "RSVP is not connected yet. Please configure the Google Sheet endpoint.";
      return;
    }

    const formData = new FormData(form);

    const data = Object.fromEntries(formData.entries());

    status.textContent = "Sending...";

    try {
      await fetch(endpoint, {
        method: "POST",
        mode: "no-cors",
        body: JSON.stringify(data),
      });

      status.textContent =
        "Thank you! We received your RSVP ❤️";

      form.reset();
    } catch (error) {
      console.error(error);

      status.textContent =
        "Something went wrong. Please try again.";
    }
  });
</script>