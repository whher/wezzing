---
import { Heart } from "lucide-astro";
import { wedding } from "../config/wedding";
---

<nav
  id="navbar"
  class="fixed top-0 left-0 z-50 w-full text-md"
>
  <div class="container-wedding flex h-16 items-center justify-between">
    <a href="#top">
      <span class="text-sm">{wedding.couple.partner1}</span>
      <span class="navbar-accent mx-1">&</span>
      <span class="text-lg">{wedding.couple.partner2}</span>
    </a>

    <div class="hidden gap-6 md:flex">
      <a href="#story" class="hover:opacity-60">Our Story</a>
      <a href="#wedding" class="hover:opacity-60">Wedding</a>
      <a href="#rsvp" class="hover:opacity-60">RSVP</a>
    </div>

    <div class="navbar-hearts flex gap-2 px-6">
      <Heart
        size={18}
        strokeWidth={1.5}
      />
      <Heart
        size={18}
        strokeWidth={1.5}
      />
    </div>
  </div>
</nav>