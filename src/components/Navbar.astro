---
import { Heart } from "lucide-astro";
import { wedding } from "../config/wedding";
---

<nav
  class="fixed top-0 left-0 z-50 w-full border-b border-black/5 bg-[#f7f2ea]/80 backdrop-blur-md"
>
  <div class="container-wedding flex h-16 items-center justify-between">
    <a
      href="#top"
      class="font-serif text-xl"
    >
      {wedding.couple.partner1}
      <span class="mx-1 text-[var(--darkrose)]"> & </span>
      {wedding.couple.partner2}
    </a>

    <div class="hidden gap-6 text-sm md:flex">
      <a href="#story" class="hover:opacity-60">Our Story</a>
      <a href="#wedding" class="hover:opacity-60">Wedding</a>
      <a href="#rsvp" class="hover:opacity-60">RSVP</a>
    </div>
    
    <Heart
      size={20}
      strokeWidth={1.5}
      class="text-[var(--darkrose)]"
    />
  </div>
</nav>