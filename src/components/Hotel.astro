---
import { MapPin } from "lucide-astro";
import SectionTitle from "./SectionTitle.astro";
import { hotels } from "../config/wedding";
---

<section
  id="wedding"
  class="bg-[var(--rose)] px-6 py-28"
>
  <div class="container-wedding">
    <div class="text-[var(--brown)]">
      <SectionTitle
        eyebrow="Make it a weekend with us"
        title="Where to Stay"
      />
    </div>

    <div class="grid gap-6 md:grid-cols-2 md:gap-8">
      {hotels.map((hotel, index) => (
        <div class="rounded-3xl bg-[var(--cream)]/90 p-8 text-center md:p-10 reveal">
          <p class="text-md uppercase tracking-widest opacity-70">
            Accommodation {index + 1}
          </p>

          <h3 class="mt-3 text-3xl">
            {hotel.name}
          </h3>

          <p class="mt-4 flex items-start justify-center gap-2 text-lg leading-6 opacity-80">
            <MapPin
              size={20}
              strokeWidth={1.5}
              class="mt-0.5 shrink-0"
            />
            <span>{hotel.address}</span>
          </p>

          <a
            href={hotel.link}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-block rounded-full bg-[var(--brown)] px-6 py-3 text-lg transition hover:-translate-y-1"
          >
            <span class="text-[var(--cream)]">View hotel</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
