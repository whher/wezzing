---
import { MapPin, Calendar, ExternalLink } from "lucide-astro";
import SectionTitle from "./SectionTitle.astro";
import { wedding, hotels } from "../config/wedding";
---

<section
  id="wedding"
  class="bg-[var(--rose)] px-6 py-28"
>
  <div class="container-wedding">
    <div class="text-[var(--brown)]">
      <SectionTitle
        eyebrow="Make it a weekend with us"
        title="Where to Stay"
      />
    </div>

  <div class="grid gap-10 md:grid-cols-2">
    {hotels.map((hotel) => (
      <div class="text-[var(--brown)] text-center">
        <p class="text-xs uppercase tracking-widest opacity-50">
          Accommodation
        </p>

        <h3 class="mt-3 font-serif text-2xl">
          {hotel.name}
        </h3>

        <p class="mt-2 text-sm leading-6 opacity-70">
          {hotel.address}
        </p>

        <a
          href={hotel.link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-block text-sm underline underline-offset-4 transition-opacity hover:opacity-60"
        >
          &#10138; Link
        </a>
      </div>
    ))}
</div>
  </div>
</section>